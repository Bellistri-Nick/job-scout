# Copy to .env and fill in. Never commit .env.

# --- Gmail ---
# IMAP_PASSWORD is a Google App Password (16 chars, spaces removed), NOT your
# Google account password. Requires 2-Step Verification:
#   myaccount.google.com/apppasswords
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@gmail.com
IMAP_PASSWORD=
# INBOX classifies every message that lands there, at one Claude call each. If
# this is also your personal mail, make a Gmail filter + label and use that:
#   IMAP_FOLDER=Jobs
IMAP_FOLDER=INBOX
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# SMTP_USER / SMTP_PASSWORD default to the IMAP values

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# Triage is a classification task; deeper thinking costs more without helping.
CLAUDE_EFFORT=low
OWNER_NAME=Your Name

# --- Alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Must NOT be the watched mailbox, or jobmail will classify its own alerts.
# Leave blank to rely on Telegram alone.
ALERT_EMAIL_TO=
# ALERT_EMAIL_FROM defaults to IMAP_USER
ALERTS_ENABLED=true
# Message types that alert even when no reply is required. An offer or an
# interview invite with a booking link asks nothing of you and is still exactly
# what you want on your phone. A message the classifier marks needs_reply always
# alerts regardless of this list. Add "rejection" if you want those too.
ALERT_ON_TYPES=recruiter_outreach,interview_request,scheduling,assessment,offer,reference_or_background,follow_up

# --- Obsidian (path on the Pi to the synced jobs vault) ---
OBSIDIAN_VAULT_PATH=/home/pi/Sync/JobsVault
OBSIDIAN_SUBFOLDER=Applications

# --- Behaviour ---
STALE_AFTER_DAYS=14
# The poller runs hourly 8am-8pm, so the longest gap is the 12 hours overnight.
# Keep this wider than that gap so a deadline can't land inside it unannounced.
DEADLINE_ALERT_HOURS=72
DRY_RUN=false

# --- Storage / dashboard ---
JOBMAIL_DATA_DIR=/home/pi/.jobmail
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
