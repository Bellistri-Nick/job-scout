# Copy to .env, fill in, then: chmod 600 .env
# The agent reads this at startup. Nothing here is committed anywhere.

# --- Email delivery -------------------------------------------------
# Use a throwaway Gmail as the sender, not a personal account.
# An App Password grants full mailbox access and cannot be scoped, so never use one
# for an account that matters.
# SMTP_PASSWORD is a Google App Password (16 chars), NOT the account password.
# Generate one at https://myaccount.google.com/apppasswords (needs 2-step verification on).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.job.agent@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM=your.job.agent@gmail.com
MAIL_TO=you@example.com
# Optional: copy yourself so you see exactly what she sees.
MAIL_CC=

# --- Claude scoring (optional but recommended) ----------------------
# Without this the agent still runs, using rule scores only.
# Set a monthly spend cap in the Anthropic console so a leak costs pocket change.
ANTHROPIC_API_KEY=
# Override the model if you want to trade quality for cost.
# JOBAGENT_MODEL=claude-opus-5

# --- Adzuna (optional) ----------------------------------------------
# Free developer key at https://developer.adzuna.com
# Covers Boston-area agency, retail, and publishing roles that never hit startup ATS boards.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Telegram push (optional) ---------------------------------------
# A tap on the shoulder when a digest is delivered. Silent no-op if unset.
#   1. Message @BotFather on Telegram, send /newbot, copy the token below
#   2. Send your new bot any message
#   3. python run.py telegram-setup    (prints your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
